# Copie este archivo como .env y complete sus claves. Nunca suba .env al repositorio.
ANTHROPIC_API_KEY=
# LangSmith (opcional): con clave, evaluar.py sube dataset y experimento; sin ella evalúa en local
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secop-taller2
# Modelo del agente (proveedor:modelo) y del juez de evaluar.py
MODELO=anthropic:claude-haiku-4-5
MODELO_JUEZ=anthropic:claude-haiku-4-5
# Precio USD por millón de tokens para estimar costo en local
PRECIO_ENTRADA_MTOK=1
PRECIO_SALIDA_MTOK=5
# muestra = 20 procesos locales | api = datos.gov.co en vivo
MODO_DATOS=muestra
SOCRATA_APP_TOKEN=
